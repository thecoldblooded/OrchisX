# ==============================================================================
# OrchisX Engine - Environment Configuration Template
# ==============================================================================

# Core Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./x_scraper.db
EXPORTS_DIR=./exports
PROXY_FILE_PATH=./proxies.txt

# REST API & Web Dashboard Server
API_HOST=0.0.0.0
API_PORT=8100
API_KEY_SECRET=change-this-to-a-secure-random-key

# Anti-Bot & Camofox Service
CAMOFOX_URL=http://localhost:9377
DEFAULT_REQUEST_TIMEOUT=20.0
MAX_RETRIES_PER_QUERY=3
RATE_LIMIT_COOLDOWN_SECONDS=900

# Webhook Notifications
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT=10.0
